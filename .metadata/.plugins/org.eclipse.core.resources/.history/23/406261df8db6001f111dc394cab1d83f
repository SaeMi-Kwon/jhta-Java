package day12;

import java.io.File;

//File 클래스 : 파일 또는 디렉토리에 관련된 정보를 갖는 클래스
public class Test01_File {
	public static void main(String[] args) {
		File f=new File("c:\\2407\\test\\aa");
		if(!f.exists()) {
			f.mkdir();  //디렉토리 생성
			System.out.println(f.getName()+"디렉토리가 생성되었습니다");
		}else if(f.exists()) {
			f.delete();  //디렉토리 삭제
			System.out.println(f.getName() + "디렉토리가 삭제되었습니다.");
		}
	}
}
