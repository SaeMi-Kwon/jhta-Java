package day11_io;

import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.FileOutputStream;
import java.io.IOException;
import java.util.Scanner;

/*
 * 	1.Scanner를 사용해서 키보드로 학생이름,국어,영어점수를 입력받아
 * 	  DataOutputStream를 사용해서 파일로 저장
 * 	  입력데이터는 3명
 * 
 * 	## student.dat
 * 
 * 	2.student.dat 파일의 데이터를 읽어와 (DataInputStream 사용)
 * 	  총점/평균을 계산해서 이름,국어,영어,총점,평균이 출력되도록 해보세요.
 * 
 */
public class Test09_Quiz {
	public static void main(String[] args) {
		Scanner scan = new Scanner(System.in);
		
		try {
			//public DataOutputStream(OutputStream out)
			DataOutputStream dos=new DataOutputStream(new FileOutputStream("student.dat"));
			
			int sum=0;
			double avg=0;
			for(int i=0;i<3;i++) {
				System.out.println("이름입력");
				String n=scan.next();
				System.out.println("국어점수입력");
				int k=scan.nextInt();
				System.out.println("영어점수입력");
				int e=scan.nextInt();

				dos.writeUTF(n);
				dos.writeInt(k);
				dos.writeInt(e);
			}
			
			dos.close();
			
			//public DataInputStream(InputStream in)
			DataInputStream dis=new DataInputStream(new FileInputStream("student.dat"));
			
			for(int i=0;i<3;i++) {
				String name=dis.readUTF();
				int kor=dis.readInt();
				int eng=dis.readInt();
				int sum1=kor+eng;
				double avg1=sum1/2.0;
				
				System.out.println(name);
				System.out.println(kor);
				System.out.println(eng);
				System.out.println(sum1);
				System.out.println(avg1);
			}
			
			dis.close();
			
		}catch(FileNotFoundException fe) {
			System.out.println(fe.getMessage());
			
		}catch(IOException ie) {
			System.out.println(ie.getMessage());
		}
		
		
		
	}
}
