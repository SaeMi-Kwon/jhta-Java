package quiz;

import java.util.Scanner;

interface MyArea{
	void input();//데이터 키보드로 입력받는 기능
	void printArea();//넓이 구해서 출력하는 기능
}

//위의 인터페이스를 상속받아 사각형 넓이,삼각형 넓이 구하는 클래스를 만들고 사용해 보세요.

class Box implements MyArea{
	private int x;
	private int y;
	
	@Override
	public void input() {
		Scanner scan = new Scanner(System.in);
		System.out.print("사각형의 가로길이 입력:");
		int x = scan.nextInt();
		System.out.print("사각형의 세로길이 입력:");
		int y = scan.nextInt();
		
		setX(x);
		setY(y);	
	}
	
	@Override
	public void printArea() {
		System.out.println("사각형의 넓이:"+ getX()* getY());
	}
	
	public int getX() {
		return x;
	}
	public int setX(int x) {
		return this.x =x;
	}
	
	public int getY() {
		return y;
	}
	public int setY(int y) {
		return this.y=y;
	}
	
}

class Triangle implements MyArea{
	private int x;
	private int y;
	
	@Override
	public void input() {
		Scanner scan = new Scanner(System.in);
		System.out.print("삼각형의 가로길이 입력:");
		int x = scan.nextInt();
		System.out.print("삼각형의 세로길이 입력:");
		int y = scan.nextInt();
		
		setX(x);
		setY(y);	
	}
	
	@Override
	public void printArea() {
		System.out.println("삼각형의 넓이:"+ (getX()* getY())/2);
	}
	
	public int getX() {
		return x;
	}
	public int setX(int x) {
		return this.x =x;
	}
	
	public int getY() {
		return x;
	}
	public int setY(int y) {
		return this.y=y;
	}
}

public class Test02 {
	public static void main(String[] args) {
		Box box = new Box();
		box.input();
		box.printArea();
		
		Triangle tri = new Triangle();
		tri.input();
		tri.printArea();
	}

}
