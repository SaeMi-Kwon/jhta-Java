package day11_io;

import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.util.Scanner;

import test.Student;

/*
 * 1.Scanner를 사용해서 키보드로 학생이름,국어,영어점수를 입력받아 총점 평균 구해서 파일로 저장
 * 	 입력데이터는 3명
 *   -> Student클래스 만들어서 저장하기
 * 
 * 2.저장된 데이터를 모두 파일에서 읽어와 화면에 출력하기
 */
public class Test13_Quiz {
	public static void main(String[] args) {
		
		try {
			ObjectOutputStream oos=new ObjectOutputStream(new FileOutputStream("student.ser"));
			
			Scanner scan= new Scanner(System.in);
			
			for(int i=0;i<3;i++) {
				System.out.println("이름입력");
				String name=scan.next();
				System.out.println("국어점수입력");
				int kor=scan.nextInt();
				System.out.println("영어점수입력");
				int eng=scan.nextInt();
				
				Student std =new Student(name,kor,eng);
				oos.writeObject(std);
			}
			
			oos.close();
			System.out.println("파일로 저장 완료");
			
			ObjectInputStream ois=new ObjectInputStream(new FileInputStream("student.ser"));
			
			for(int i=0;i<3;i++) {
				Student sd= (Student)ois.readObject();
				//System.out.println(sd.getName() +","+ sd.getKor() + "," + sd.getEng() + "," + sd.getSum() +","+ sd.getAvg());
				sd.print();
			}
			ois.close();
			
		}catch(FileNotFoundException fe) {
			System.out.println(fe.getMessage());
			
		}catch(IOException ie) {
			System.out.println(ie.getMessage());
			
		}catch(ClassNotFoundException ce) {
			System.out.println(ce.getMessage());
		}
		
	}
}
