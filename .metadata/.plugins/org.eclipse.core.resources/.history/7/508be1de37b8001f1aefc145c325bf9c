package day14_thread1;
/*
 * < 덧셈계산 프로그램 >
 * 임의의 난수를 두개 더해서 맞추는 프로그램
 * 시간은 60초가 주어진다.(스레드로 시간체크하기)
 */

import java.util.Random;
import java.util.Scanner;

class RandomNum implements Runnable{
	@Override
	public void run() {
		Random r=new Random();
		Scanner scan=new Scanner(System.in);	
		
		while(true) {
			int n1=r.nextInt(9)+1;
			int n2=r.nextInt(9)+1;
			int n3=n1+n2;
			
			int result=scan.nextInt();
			System.out.println(n1+ "+" + n2 + "=" + result);
			
			int count=0;
			if(n3==result) {
				count++;
				System.out.println("정답입니다. 맞은 갯수:" + count);
			}
			System.out.println("최종 맞은 갯수:" + count);
		}
		
		
	}
}


class TimeAttack extends Thread{
	
	@Override
	public void run() {
		//final int MAX=60000;
	
			try {
				for(int i=60000;i<0;i--) {
					Thread.sleep(1000);
					if(i%10==0) {
						System.out.println(i + "초 남았습니다.");
					}
					System.out.println("게임이 종료됩니다.");
				}
				
				
			} catch (InterruptedException e) {
				System.out.println(e.getMessage());
			}
			
		
	
	}
}

public class Test02_Quiz {
	public static void main(String[] args) {
		//new Thread(new RandomNum()).start();
		
		TimeAttack timeThread=new TimeAttack();
		timeThread.start();
	}
}
