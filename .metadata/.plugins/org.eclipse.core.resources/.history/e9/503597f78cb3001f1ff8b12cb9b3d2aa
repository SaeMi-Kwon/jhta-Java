package quiz;

class Box implements MyArea{
	private int x;
	private int y;
		
	@Override
	public void input() {
		Scanner scan = new Scanner(System.in);
		System.out.print("사각형의 가로길이 입력:");
		int x = scan.nextInt();
		System.out.print("사각형의 세로길이 입력:");
		int y = scan.nextInt();
		
		setX(x);
		setY(y);	
	}
	
	@Override
	public void printArea() {
		System.out.println("사각형의 넓이:"+ getX()* getY());
	}
	
	public int getX() {
		return x;
	}
	public int setX(int x) {
		return this.x =x;
	}
	
	public int getY() {
		return y;
	}
	public int setY(int y) {
		return this.y=y;
	}
	
}
class Triangle implements MyArea{
	private int x;
	private int y;
	
	@Override
	public void input() {
		Scanner scan = new Scanner(System.in);
		System.out.print("삼각형의 가로길이 입력:");
		int x = scan.nextInt();
		System.out.print("삼각형의 세로길이 입력:");
		int y = scan.nextInt();
		
		setX(x);
		setY(y);	
	}
	@Override
	public void printArea() {
		System.out.println("삼각형의 넓이:"+ (getX()* getY())/2);
	}
	
	public int getX() {
		return x;
	}
	public int setX(int x) {
		return this.x =x;
	}
	
	public int getY() {
		return x;
	}
	public int setY(int y) {
		return this.y=y;
	}
}

public class Test02 {
	public static void main(String[] args) {
		Box box = new Box();
		box.input();
		box.printArea();
		
		Triangle tri = new Triangle();
		tri.input();
		tri.printArea();
	}

}
