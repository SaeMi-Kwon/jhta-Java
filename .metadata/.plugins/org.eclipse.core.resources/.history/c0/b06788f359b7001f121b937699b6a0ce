package day13;

import javax.swing.JButton;
import javax.swing.JFrame;
/*
 * [ 자바에서의 이벤트 처리 ]
 * 1. 이벤트 - 윈도우상에서 발생되는 여러 사건(마우스 클릭,키보드누름,윈도우 닫힘,...)
 * 2. 이벤트 처리
 * 	-이벤드가 발생되었을때 실행할 작업을 구현하는 것
 * 	-이벤트 처리 순서
 * 	1)이벤트 리스너 클래스 만들기 (이벤트가 발생되었을때 실행될 기능 구현)
 * 	2)이벤트 리스너 객체 생성
 * 	3)이벤트가 발생되는 타켓객체에 이벤트리스너 객체 연결하기
 * 
 */

//프레임을 상속받는 클래스를 만들어 화면에 띄워보세요.
//프레임에는 버튼이 두개 붙어 있음
class MyFrame extends JFrame{
	JButton btn1=new JButton("버튼1");
	JButton btn2=new JButton("버튼2");

	public MyFrame() {
		super("윈도우");
		
		//public void setLayout(LayoutManager manager)
		setLayout(null); //레이아웃매니져 사용안함 - 이때는 컴포넌트 사이즈와 위치를 설정해줘야 함
		btn1.setSize(100,50); //버튼 크기설정
		btn1.setLocation(10,50);  //버튼 위치설정
		
		btn2.setSize(100,50);
		btn2.setLocation(110,50);
		
		add(btn1);
		add(btn2);
		
		setSize(600,500);  //창 크기
		setVisible(true);
	}
}


public class Test01_Event {
	public static void main(String[] args) {
		new MyFrame();
	}
}
