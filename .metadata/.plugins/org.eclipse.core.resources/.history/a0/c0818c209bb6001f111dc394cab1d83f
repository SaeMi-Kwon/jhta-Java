package day12;

import java.io.File;

public class Test04_Quiz {
	public static void main(String[] args) {
		//코드로 bb폴더를 삭제해 보세요.
		File f=new File("c:\\2407\\test\\bb");
		
		File[] list=f.listFiles();
		
		//디렉토리안의 파일들을 모두 삭제하기
		for(File ff:list) {
			ff.delete();
			System.out.println("파일삭제");
		}
		
		//자신의 폴더 삭제하기
		if(f.delete()) {
			System.out.println(f.getName()+"폴더 삭제 성공");
		}else {
			System.out.println(f.getName()+"폴더 삭제 실패");
		}
		
	}
}
