package day10;

import java.io.FileWriter;
import java.io.IOException;

//FileWriter : 2바이트 단위로 파일에 출력하는 기능을 갖는 출력스트림클래스

public class Test05_FileWriter {
	public static void main(String[] args) {
		
		try {
			//public FileWriter(String fileName) throws IOException
			//파일에 출력하기 위한 2바이트처리 스트림 객체 생성
			FileWriter fw=new FileWriter("c:\\2407\\hello.txt",true);  //경로표시할때마다 \\를 사용한다
			fw.write("hello~~~~\n");  // \n 줄바꿈
			fw.write("반가워요~~~\n");
			
			fw.close();
			
			System.out.println("파일로 저장 완료!!!");
			
		}catch(IOException ie) {
			System.out.println(ie.getMessage());
		}
		
	}
}
