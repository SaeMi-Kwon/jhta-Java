package day10;

import java.io.IOException;
import java.io.InputStream;

/*
 * [자바의 IO(Input/Output)]
 * - 데이터를 읽어오거나 출력에 관련된 기능
 * - 스트림 : 데이터의 흐름 (자바는 데이터를 입출력할때 스트림(Stream)을 사용한다.)
 * - 스트림은 근원지(source) 또는 목적지(destination)가 존재한다.
 *   *입력(근원지)/출력(목적지)*
 * 
 * - 스트림의 종류
 * 	 1바이트 스트림 : 1바이트 단위로 데이터를 처리 - ~InputStream, ~OutputStream
 *   2바이트 스트림 : 2바이트 단위로 데이터를 처리(문자처리) ~Reader ~Writer
 */


//InputStream : 스트림을 1바이트 단위로 읽어오는 입력스트립 클래스(추상클래스)
public class Test01 {
	public static void main(String[] args) {
		
		//System.in : 자바가 제공하는 키보드로부터 데이터를 읽어오기 위한 스트림 객체
		InputStream in = System.in;
		System.out.println("글자 한자만 입력하세요");
		
		try {
			//public abstract int read() throws IOException :스트림으로부터 1바이트 읽어오는 메소드
			int a=in.read();
			System.out.println("입력된 글자:" + (char)a);
		}catch(IOException e){
			System.out.println(e.getMessage());
			
		}
		
		
		
	}
}
