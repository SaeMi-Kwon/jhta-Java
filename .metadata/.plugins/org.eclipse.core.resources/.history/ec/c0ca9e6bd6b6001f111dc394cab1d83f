package quiz;

import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.File;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.IOException;
import java.io.InputStreamReader;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.Scanner;

//1. 일기장 없으면 만들기 mkdir()사용/ txt파일 임의로 만들기
//입력한 내용이 일기에 저장
//파일명은 오늘날짜.txt 로컬데이터클래스에 현재날짜 얻어올수있음

/*
  	c:\일기장이라는 폴더에는 일기가 텍스트파일로 저장되어 있다.
  	아래와 같은 작업이 수행되도록 프로그램을 작성해 보세요.
  	1. 일기쓰기 2.일기읽기
  	1번을 입력하면 exit가 입력될때까지 문자열을 입력받아 파일로 저장한다. 파일명은
  	오늘날짜.txt로 저장. 만약 일기장 폴더가 없으면 생성하고 파일을 저장한다.
  	2번을 입력하면 일기장 폴더안에 파일목록들이 보여지고 파일명을 입력하면
  	해당 내용을 불러와 화면에 출력한다.

  	[[ 실행결과 ]]
  	1. 일기쓰기 2.일기읽기
  	선택번호입력 : 2
  	c:\일기장 파일의 파일목록
  	20240910.txt
  	20240911.txt
 	..
  	열고자 하는 파일명 입력:20240911.txt
 */

public class Test01 {
	public static void main(String[] args) {
		File f=new File("c:\\diary");
		String path=f.getAbsolutePath();
		BufferedReader br=null;
		BufferedWriter bw=null;
		
		//오늘날짜 
		DateTimeFormatter df = DateTimeFormatter.ofPattern("yyyyMMdd");
		String day =LocalDateTime.now().format(df);

		if(!f.exists()) {
			f.mkdirs(); 
		}
		
		Scanner scan = new Scanner(System.in);
		while(true) {
			System.out.println("1.일기쓰기  2.일기읽기");
			int num=scan.nextInt();
			scan.nextLine(); //비우기
			
			if(num==1) {
				try {
					
					
					br=new BufferedReader(new InputStreamReader(System.in));
					bw=new BufferedWriter(new FileWriter(f.getAbsolutePath()+"\\"+day +".txt"));
		
					System.out.println("[일기를 작성하세요]");
					while(true) {
						String input=br.readLine();
						if(input.equals("exit")) break;
						bw.write(input);
						
					}
					
				
					System.out.println("쓰기완료");
					
				}catch(IOException ie) {
					System.out.println(ie.getMessage());
					
				}finally {
					try {
						if(br!=null) br.close();
						if(bw!=null) bw.close();
					}catch(IOException e) {
						System.out.println(e.getMessage());
					}
				}
				
			}else if(num==2) {
				//File[] list=f.listFiles();
				
			}else {
				System.out.println("번호를 다시 입력하세요");
			}
			
		}
	}
}
