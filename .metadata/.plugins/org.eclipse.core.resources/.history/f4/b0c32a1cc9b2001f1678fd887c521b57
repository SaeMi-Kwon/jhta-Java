package day09_enum;

//사번 이름 직책을 저장하는 클래스를 만들고 사용해 보세요.
//직책은 enum 사용하기(사장/관리자/사원)

class Emp{
	private int num;
	private String name;
	private Det det;
	
	public Emp(int num,String name,Det det) {
		this.num=num;
		this.name=name;
		this.det=det;
	}
	
	public void print() {
		System.out.println("사번:" + num);
		System.out.println("이름:" + name);
		System.out.println("직책:" + det);
	}
}

enum Det{
	OWNER,ADMIN,STAFF
}

public class Test06_Quiz {
	public static void main(String[] args) {
		Emp e=new Emp(1,"홍길동",Det.STAFF);
		e.print();
	}
}
