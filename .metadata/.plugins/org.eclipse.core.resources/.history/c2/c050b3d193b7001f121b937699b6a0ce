class MyScore extends JFrame{

	JTextField txtNum=new JTextField(10);
	JTextField txtKor=new JTextField(10);
	JTextField txtEng=new JTextField(10);
	JButton btnSave=new JButton("저장");
	JButton btnOpen=new JButton("열기");
	JPanel pan1=new JPanel();
	
	DefaultListModel<String> model=new DefaultListModel<>();
	JList<String> list=new JList<>(model);
	
	public MyScore() {
		setLayout(new BorderLayout());
		
		pan1.add(new JLabel("번호"));
		pan1.add(txtNum);
		pan1.add(new JLabel("국어"));
		pan1.add(txtKor);
		pan1.add(new JLabel("영어"));
		pan1.add(txtEng);
		pan1.add(btnSave);
		pan1.add(btnOpen);
		
		add(pan1,BorderLayout.NORTH);
		add(list,BorderLayout.CENTER);
		
		setSize(600,500);
		setVisible(true);
	}
}


