package day10;

import java.io.IOException;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.Reader;

//Reader - 스트림을 2바이트 단위로 읽어오기 위한 스트림 클래스(추상클래스)
//InputStreamReader - Reader의 자식 클래스. 2바이트 단위로 데이터를 읽어오는 입력스트림

public class Test02_Reader {
	public static void main(String[] args) {
		
		//System클래스 --> public static final InputStream in (타입:InputStream)
		InputStream in =System.in;
	
		//InputStreamReader(InputStream in)
		Reader r=new InputStreamReader(in);
		System.out.println("글자 한자만 입력하세요");
		
		try {
			//public int read() throws IOException : 스트림으로부터 데이터를 2바이트 단위로 읽어오는 메소드
			int a=r.read();  //char하나 읽어오기
			System.out.println("입력된 글자:" + (char)a);
			
		}catch(IOException e) {
			System.out.println(e.getMessage());
		}
		
	}
}
