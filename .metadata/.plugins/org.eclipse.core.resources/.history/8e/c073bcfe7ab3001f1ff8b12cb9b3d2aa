package day10;
import java.io.*;

//Writer : 2바이트 단위로 데이터를 출력하는 기능의 스트림(문자처리) - 추상클래스
//OutputStreamWriter : Writer의 자식클래스. 2바이트 출력스트림 클래스
public class Test04_Writer {
	public static void main(String[] args) {
		
		OutputStream os=System.out;
		
		try {
			//OutputStreamWriter(OutputStream out) -->생성자
			Writer w=new OutputStreamWriter(os);
			w.write("Hello");
			
			
			char[] c= {'아','리','랑'};
			w.write(c);
			
			w.close();
			
		}catch(IOException ie) {
			System.out.println(ie.getMessage());
		}
		
	}
}
