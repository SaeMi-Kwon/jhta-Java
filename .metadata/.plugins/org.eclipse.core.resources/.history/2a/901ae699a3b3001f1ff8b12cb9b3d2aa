package day10;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

/*
	BufferedReader(Reader in) -->생성자
	
	InputStream is = System.in;
	Reader in=new InputStreamReader(is);
	BufferedReader br=new BufferedReader(in);
	
	BufferedReader br=new BufferedReader(new InputStreamReader(System.in));
*/
public class Test12_BufferedReader {
	public static void main(String[] args) {
		//BufferedReader를 사용해서 키보드로 한줄 읽어와 화면에 출력해 보세요.
		
		BufferedReader br=new BufferedReader(new InputStreamReader(System.in));
		
		//public String readLine() throws IOException
		try {
			System.out.println("한 줄 입력:");
			String line=br.readLine();
			System.out.println("입력된 문장:" + line);
			
			br.close();  //겉에 있는거 닫아주면된다.(버퍼는 안해줘도 되지만 파일에 연결된것은 반드시 닫아준다)
			
		}catch(IOException ie) {
			System.out.println(ie.getMessage());
		}
		
	}
}
