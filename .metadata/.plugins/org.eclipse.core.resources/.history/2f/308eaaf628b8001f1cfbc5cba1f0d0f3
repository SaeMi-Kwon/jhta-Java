package day14_thread;

/*
 * 스레드 만들기
 * 1. Thread클래스 상속받기
 * 2. run메소드 오버라이딩하기 - 스레드로 실행되어야 할 기능 구현
 * 3. 스레드객체 생성해서 start메소드 호출하기
 */

class FileCopyThread extends Thread{
	@Override
	public void run() {
		for(int i=1;i<=1000;i++) {
			System.out.print("파일복사중!!");
			if(i%10==0) System.out.println();
		}
		System.out.println("<<<< 파일복사완료 >>>>");
	}
}

//인쇄하는 스레드 만들고 실행해 보세요
class FilePrintThread extends Thread{
	@Override
	public void run() {
		for(int i=1;i<=1000;i++) {
			System.out.print("파일인쇄중@@");
			if(i%10==0) System.out.println();
		}
		System.out.println("&&&& 파일복사완료 &&&&");
	}
}

public class Test02_Thread {
	public static void main(String[] args) {
		FileCopyThread copyThread=new FileCopyThread();
		copyThread.start();  //start메소드로 스레드 실행하기 -> 스레드로 구동시키고 내부적으로 run메소드 호출한다.
		
		FilePrintThread printThread=new FilePrintThread();
		printThread.start();
	}
}
